# Copie para .env.local e preencha. Nunca faça commit de .env.local.
# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Domínio técnico usado para transformar o MASP em "e-mail" de login (opcional)
# NEXT_PUBLIC_MASP_EMAIL_DOMAIN=servidor.fhemigo.local

# Agente no n8n (opcional até o agente existir)
# N8N_WEBHOOK_URL=https://seu-n8n/webhook/fhemigo-responde
# N8N_WEBHOOK_SECRET=um-segredo-longo-e-aleatorio
